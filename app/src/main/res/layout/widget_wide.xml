<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_sub"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/w_big"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/w_on"
            android:textSize="36sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/w_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/w_sub"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:gravity="end|center_vertical"
        android:minWidth="110dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_stats"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/w_on"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/w_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:minWidth="110dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/w_btn_on"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
